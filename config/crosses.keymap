#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &gggw_crosses_36_layout; };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <12 13>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <11 12>;
        };

        delete {
            bindings = <&kp DEL>;
            key-positions = <2 3>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <2 1>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <2 13>;
        };

        enter_right {
            bindings = <&kp ENTER>;
            key-positions = <17 18>;
        };

        backspace_right {
            bindings = <&kp BACKSPACE>;
            key-positions = <16 17>;
        };

        waver {
            bindings = <&kp TILDE>;
            key-positions = <11 2>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <11 12 13>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q    &kp W  &kp E  &kp R             &kp T            &kp Y        &kp U          &kp I          &kp O       &kp P
&kp A    &kp S  &kp D  &mt LEFT_SHIFT F  &kp G            &kp H        &mt RSHFT J    &mt RCTRL K    &mt RALT L  &kp SEMICOLON
&lt 3 Z  &kp X  &kp C  &kp V             &kp B            &kp N        &kp M          &kp COMMA      &kp DOT     &lt 3 SLASH
                &mo 1  &kp SPACE         &mt LCTRL SPACE  &lt 2 ENTER  &kp BACKSPACE  &kp RIGHT_ALT
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp N7         &kp N8         &kp N9  &kp F4
&kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8    &kp SEMICOLON     &kp SQT            &kp N4         &kp N5         &kp N6  &kp F8
&kp NUMBER_9  &kp NUMBER_0  &kp MINUS     &kp EQUAL       &kp BACKSLASH     &kp MINUS          &kp N1         &kp N2         &kp N3  &kp F12
                            &kp LCTRL     &kp LEFT_SHIFT  &trans            &kp N0             &kp BACKSPACE  &kp RIGHT_WIN
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp LS(N1)  &kp LS(N2)  &kp LS(N3)     &kp LS(N4)      &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &none           &none           &none            &none
&kp LS(N5)  &kp LS(N6)  &kp LS(N7)     &kp LS(N8)      &kp LS(SEMICOLON)     &kp LS(SQT)            &none           &kp UP_ARROW    &none            &none
&kp LS(N9)  &kp LS(N0)  &kp LS(MINUS)  &kp LS(EQUAL)   &kp LS(BACKSLASH)     &none                  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none
                        &kp LCTRL      &kp LEFT_SHIFT  &kp SPACE             &trans                 &kp BACKSPACE   &kp RIGHT_ALT
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR  &bt BT_CLR      &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0
&none         &none         &mkp RCLK     &mkp LCLK  &none       &none           &none      &none         &none         &none
&trans        &none         &none         &none      &none       &studio_unlock  &none      &none         &none         &trans
                            &mkp MCLK     &mkp LCLK  &mkp RCLK   &mkp RCLK       &mkp LCLK  &mkp MCLK
            >;
        };
    };
};
